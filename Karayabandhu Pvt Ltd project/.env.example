# ==========================================
# Karaya Bandhu - Environment Configuration
# ==========================================

# MongoDB Database Connection URL
MONGODB_URI=mongodb://127.0.0.1:27017/karayabandhu
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/karayabandhu?retryWrites=true&w=majority

# Admin Portal Authentication Credentials
ADMIN_USERNAME=kbadmin
ADMIN_PASSWORD=your_secure_admin_password_here

# JWT Secret Key for Session Authentication
ADMIN_SECRET=your_jwt_super_secret_key_here
